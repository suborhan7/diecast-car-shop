# Public URL of the site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Password for the owner's orders page at /admin (at least 6 characters)
ADMIN_PASSWORD=
# Order database: added automatically when you connect Upstash for Redis in Vercel (Storage tab)
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Optional: every order is also POSTed here as JSON (e.g. a Google Sheets Apps Script or Discord webhook)
ORDER_WEBHOOK_URL=
